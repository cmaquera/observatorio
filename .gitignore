# ==============================================================================
# Observatorio de Obras Públicas del Perú - .gitignore
# ==============================================================================

# Python & Entornos Virtuales
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.env

# Archivos de caché y logs de ejecución
backend/data/cache_adjuntos/
*.log
scratch*.py
test_temp*.py

# SQLite temporales (WAL / SHM / Journal)
*.db-wal
*.db-shm
*.db-journal

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Sistema Operativo y Editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
